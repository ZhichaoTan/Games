diff --git a/src/main.cpp b/src/main.cpp
index 57667d1..10cd4d6 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -28,6 +28,48 @@
 
 using namespace Stockfish;
 
+#ifdef PF_WEB
+
+// Web build: no stdin loop. The page calls pf_init() once and then
+// pf_command() with one UCI command line at a time; the engine's replies come
+// back through the Module's print callback. A "go" returns when the search is
+// over (see thread.cpp), so give it a depth, a node count or a move time.
+#include <emscripten/emscripten.h>
+
+namespace {
+std::unique_ptr<UCIEngine> webUci;
+}
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE int pf_init() {
+    if (webUci)
+        return 1;
+
+    std::cout << engine_info() << std::endl;
+
+    Attacks::init();
+    Position::init();
+
+    static char  arg0[] = "pikafish";
+    static char* argv[] = {arg0, nullptr};
+
+    webUci = std::make_unique<UCIEngine>(CommandLine(1, argv));
+    Tune::init(webUci->engine_options());
+    return 1;
+}
+
+EMSCRIPTEN_KEEPALIVE void pf_command(const char* cmd) {
+    if (webUci && cmd)
+        webUci->execute(cmd);
+}
+
+}  // extern "C"
+
+int main() { return 0; }
+
+#else
+
 #ifdef UNIVERSAL_BINARY
 namespace Stockfish {
 
@@ -59,3 +101,5 @@ int main(int argc, char* argv[]) {
 int main(int argc, char* argv[]) { return Stockfish::main(argc, argv); }
     #endif
 #endif
+
+#endif  // PF_WEB
diff --git a/src/thread.cpp b/src/thread.cpp
index 1f3f813..42bd65a 100644
--- a/src/thread.cpp
+++ b/src/thread.cpp
@@ -45,6 +45,48 @@ namespace Stockfish {
 
 // Constructor launches the thread and waits until it goes to sleep
 // in idle_loop(). Note that 'searching' and 'exit' should be already set.
+#ifdef PF_WEB
+// Web build (single-threaded WebAssembly, no pthreads): there is no native
+// thread. Jobs run at once on the calling thread, so a search has finished
+// by the time start_searching() returns.
+Thread::Thread(Search::SharedState&                   sharedState,
+               std::unique_ptr<Search::SearchManager> sm,
+               usize                                  n,
+               usize                                  numaN,
+               usize                                  totalNumaCount,
+               OptionalThreadToNumaNodeBinder         binder) :
+    idx(n),
+    idxInNuma(numaN),
+    totalNuma(totalNumaCount) {
+
+    searching             = false;
+    this->numaAccessToken = binder();
+    this->worker          = make_unique_large_page<Search::Worker>(
+      sharedState, std::move(sm), n, idxInNuma, totalNuma, this->numaAccessToken);
+}
+
+Thread::~Thread() {}
+
+void Thread::start_searching() {
+    assert(worker != nullptr);
+    worker->start_searching();
+}
+
+void Thread::clear_worker() {
+    assert(worker != nullptr);
+    worker->clear();
+}
+
+void Thread::wait_for_search_finished() {}
+
+void Thread::run_custom_job(std::function<void()> f) { f(); }
+
+void Thread::ensure_network_replicated() { worker->ensure_network_replicated(); }
+
+void Thread::idle_loop() {}
+
+#else
+
 Thread::Thread(Search::SharedState&                   sharedState,
                std::unique_ptr<Search::SearchManager> sm,
                usize                                  n,
@@ -145,6 +187,8 @@ void Thread::idle_loop() {
     }
 }
 
+#endif  // PF_WEB
+
 Search::SearchManager* ThreadPool::main_manager() { return main_thread()->worker->main_manager(); }
 
 u64 ThreadPool::nodes_searched() const { return accumulate(&Search::Worker::nodes); }
